# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zknotes:zknotes@localhost:5432/zknotes
# >= 32 random bytes. Generate with: openssl rand -hex 32
SERVER_SECRET=
# Exact origin(s) the web app is served from (comma-separated). Must be https in production.
ALLOWED_ORIGINS=http://localhost:5173
# Express "trust proxy": false | true | <hop count> | <subnet list>. Set correctly behind a reverse proxy.
TRUST_PROXY=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=168
ARGON2_MAX_CONCURRENCY=4
# Serve the built web app from Express (same-origin production deployment):
# STATIC_DIR=../web/dist
# Integration tests:
# TEST_DATABASE_URL=postgres://zknotes:zknotes@localhost:5432/zknotes_test
